# Normalize repository-owned text files across platforms.
* text=auto
*.py text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Preserve original upload bytes, including original text line endings.
dataset/** -text -whitespace
dataset/*.npz binary
dataset/*.mat binary
dataset/*.bz2 binary
dataset/README.md text eol=lf !whitespace
dataset/manifest.json text eol=lf !whitespace
